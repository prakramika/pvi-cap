{
  "workspace": {
    "folders": [
      { "key": "dashboard", "title": "PVI Project Dashboard", "icon": "📊" },
      { "key": "clientPortal", "title": "Client Portal", "icon": "👁️" },
      { "key": "weeklyReports", "title": "Weekly Reports", "icon": "📝" },
      { "key": "databases", "title": "Databases", "icon": "🗃️" },
      { "key": "internalNotesPage", "title": "Internal Notes", "icon": "🔒" },
      { "key": "templates", "title": "Templates", "icon": "📋" },
      { "key": "howTo", "title": "How to use this workspace", "icon": "📘" }
    ]
  },
  "statusOptions": [
    { "name": "Not Started", "color": "gray" },
    { "name": "In Progress", "color": "blue" },
    { "name": "Client Review", "color": "yellow" },
    { "name": "Blocked", "color": "red" },
    { "name": "Completed", "color": "green" }
  ],
  "phaseOptions": [
    { "name": "Project Initiation", "color": "gray" },
    { "name": "Requirement Analysis", "color": "brown" },
    { "name": "Solution Architecture", "color": "orange" },
    { "name": "UI/UX & User Flow", "color": "yellow" },
    { "name": "Application Foundation", "color": "green" },
    { "name": "Core Development", "color": "blue" },
    { "name": "Assessment/Questionnaire Module", "color": "purple" },
    { "name": "Admin & Reporting", "color": "pink" },
    { "name": "Testing & Security", "color": "red" },
    { "name": "AWS Deployment", "color": "orange" },
    { "name": "UAT", "color": "yellow" },
    { "name": "Production Release & Handover", "color": "green" }
  ],
  "priorityOptions": [
    { "name": "High", "color": "red" },
    { "name": "Medium", "color": "yellow" },
    { "name": "Low", "color": "gray" }
  ],
  "internalProperties": {
    "milestones": ["Internal Notes"],
    "weekly": ["Internal Notes"],
    "meetings": ["Internal Notes"],
    "billing": ["Internal Notes"],
    "changeRequests": ["Estimated Effort", "Timeline Impact", "Cost Impact", "Internal Notes"],
    "risks": ["Internal Notes"],
    "documents": ["Internal Notes"],
    "projectControl": ["Internal Notes"],
    "internalNotes": ["Internal Notes"]
  },
  "databases": {
    "milestones": {
      "title": "Project Milestones",
      "icon": "🏁",
      "parent": "databases",
      "titleProperty": "Milestone Name",
      "properties": {
        "Milestone Name": { "type": "title" },
        "Milestone ID": { "type": "unique_id", "prefix": "M" },
        "Order": { "type": "number", "format": "number" },
        "Phase": { "type": "select", "optionsKey": "phaseOptions" },
        "Description": { "type": "rich_text" },
        "Start Date": { "type": "date" },
        "End Date": { "type": "date" },
        "Duration": {
          "type": "formula",
          "expression": "if(or(empty(prop(\"Start Date\")), empty(prop(\"End Date\"))), 0, dateBetween(prop(\"End Date\"), prop(\"Start Date\"), \"days\"))"
        },
        "Status": { "type": "select", "optionsKey": "statusOptions" },
        "Progress %": { "type": "number", "format": "number" },
        "Priority": { "type": "select", "optionsKey": "priorityOptions" },
        "Deliverables": { "type": "rich_text" },
        "Client Review Required": { "type": "checkbox" },
        "Client Approval Required": { "type": "checkbox" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "All Milestones",
          "type": "table",
          "replaceDefault": true,
          "sorts": [{ "property": "Order", "direction": "ascending" }],
          "hideProperties": ["Internal Notes"]
        },
        {
          "name": "Timeline",
          "type": "timeline",
          "dateProperty": "Start Date",
          "endDateProperty": "End Date",
          "arrowsBy": "Dependencies",
          "colorBy": true,
          "showTable": true,
          "hideProperties": ["Internal Notes"]
        },
        {
          "name": "By Status",
          "type": "board",
          "groupBy": { "property": "Status", "type": "select" },
          "hideProperties": ["Internal Notes"]
        }
      ]
    },
    "weekly": {
      "title": "Weekly Delivery",
      "icon": "📅",
      "parent": "databases",
      "titleProperty": "Week",
      "properties": {
        "Week": { "type": "title" },
        "Week ID": { "type": "unique_id", "prefix": "W" },
        "Start Date": { "type": "date" },
        "End Date": { "type": "date" },
        "Objective": { "type": "rich_text" },
        "Planned Work": { "type": "rich_text" },
        "Deliverables": { "type": "rich_text" },
        "Demo Items": { "type": "rich_text" },
        "Completed This Week": { "type": "rich_text" },
        "Status": { "type": "select", "optionsKey": "statusOptions" },
        "Progress %": { "type": "number", "format": "number" },
        "Client Review": {
          "type": "select",
          "options": [
            { "name": "Not Required", "color": "gray" },
            { "name": "Pending", "color": "yellow" },
            { "name": "Done", "color": "green" }
          ]
        },
        "Client Decisions Required": { "type": "rich_text" },
        "Risks": { "type": "rich_text" },
        "Blockers": { "type": "rich_text" },
        "Next Week Plan": { "type": "rich_text" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Current Week",
          "type": "table",
          "replaceDefault": true,
          "filter": { "property": "Status", "select": { "equals": "In Progress" } }
        },
        {
          "name": "All Weeks",
          "type": "table",
          "sorts": [{ "property": "Week ID", "direction": "ascending" }]
        },
        {
          "name": "Completed",
          "type": "table",
          "filter": { "property": "Status", "select": { "equals": "Completed" } },
          "sorts": [{ "property": "Week ID", "direction": "descending" }]
        },
        {
          "name": "Client Review",
          "type": "table",
          "filter": {
            "or": [
              { "property": "Client Review", "select": { "equals": "Pending" } },
              { "property": "Status", "select": { "equals": "Client Review" } }
            ]
          }
        }
      ]
    },
    "meetings": {
      "title": "Client Meetings & Decisions",
      "icon": "🗓️",
      "parent": "databases",
      "titleProperty": "Meeting Title",
      "properties": {
        "Meeting Title": { "type": "title" },
        "Meeting ID": { "type": "unique_id", "prefix": "MTG" },
        "Date": { "type": "date" },
        "Meeting Type": {
          "type": "select",
          "options": [
            { "name": "Kickoff", "color": "blue" },
            { "name": "Weekly Sync", "color": "gray" },
            { "name": "Demo / Review", "color": "purple" },
            { "name": "Decision", "color": "yellow" },
            { "name": "UAT", "color": "orange" },
            { "name": "Ad-hoc", "color": "default" }
          ]
        },
        "Participants": { "type": "rich_text" },
        "Agenda": { "type": "rich_text" },
        "Discussion": { "type": "rich_text" },
        "Decisions": { "type": "rich_text" },
        "Action Items": { "type": "rich_text" },
        "Owner": {
          "type": "select",
          "options": [
            { "name": "Consultant", "color": "blue" },
            { "name": "Client", "color": "orange" }
          ]
        },
        "Due Date": { "type": "date" },
        "Client Approval Required": { "type": "checkbox" },
        "Approval Status": {
          "type": "select",
          "options": [
            { "name": "Not Required", "color": "gray" },
            { "name": "Pending", "color": "yellow" },
            { "name": "Approved", "color": "green" },
            { "name": "Rejected", "color": "red" }
          ]
        },
        "Follow-up Date": { "type": "date" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Upcoming Meetings",
          "type": "table",
          "replaceDefault": true,
          "filterKind": "upcomingDate",
          "dateProperty": "Date",
          "sorts": [{ "property": "Date", "direction": "ascending" }]
        },
        {
          "name": "Meeting History",
          "type": "table",
          "filterKind": "pastDate",
          "dateProperty": "Date",
          "sorts": [{ "property": "Date", "direction": "descending" }]
        },
        {
          "name": "Pending Decisions",
          "type": "table",
          "filter": {
            "and": [
              { "property": "Decisions", "rich_text": { "is_not_empty": true } },
              { "property": "Approval Status", "select": { "equals": "Pending" } }
            ]
          }
        },
        {
          "name": "Pending Approvals",
          "type": "table",
          "filter": {
            "and": [
              { "property": "Client Approval Required", "checkbox": { "equals": true } },
              { "property": "Approval Status", "select": { "equals": "Pending" } }
            ]
          }
        }
      ]
    },
    "billing": {
      "title": "Billing Tracker",
      "icon": "💳",
      "parent": "databases",
      "titleProperty": "Invoice/Milestone ID",
      "properties": {
        "Invoice/Milestone ID": { "type": "title" },
        "Billing ID": { "type": "unique_id", "prefix": "INV" },
        "Planned Billing Date": { "type": "date" },
        "Amount": { "type": "number", "format": "number_with_commas" },
        "Invoice Date": { "type": "date" },
        "Amount Billed": { "type": "number", "format": "number_with_commas" },
        "Amount Received": { "type": "number", "format": "number_with_commas" },
        "Balance": {
          "type": "formula",
          "expression": "if(empty(prop(\"Amount Billed\")), 0, prop(\"Amount Billed\")) - if(empty(prop(\"Amount Received\")), 0, prop(\"Amount Received\"))"
        },
        "Payment Status": {
          "type": "select",
          "options": [
            { "name": "Upcoming", "color": "gray" },
            { "name": "Invoiced", "color": "yellow" },
            { "name": "Partially Paid", "color": "orange" },
            { "name": "Paid", "color": "green" },
            { "name": "Overdue", "color": "red" }
          ]
        },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Billing Overview",
          "type": "table",
          "replaceDefault": true,
          "sorts": [{ "property": "Billing ID", "direction": "ascending" }]
        },
        {
          "name": "Pending Payments",
          "type": "table",
          "filter": {
            "or": [
              { "property": "Payment Status", "select": { "equals": "Invoiced" } },
              { "property": "Payment Status", "select": { "equals": "Partially Paid" } },
              { "property": "Payment Status", "select": { "equals": "Overdue" } }
            ]
          }
        },
        {
          "name": "Paid",
          "type": "table",
          "filter": { "property": "Payment Status", "select": { "equals": "Paid" } }
        },
        {
          "name": "Upcoming Billing",
          "type": "table",
          "filter": { "property": "Payment Status", "select": { "equals": "Upcoming" } }
        }
      ]
    },
    "changeRequests": {
      "title": "Change Requests",
      "icon": "🔀",
      "parent": "databases",
      "titleProperty": "CR Title",
      "properties": {
        "CR Title": { "type": "title" },
        "CR ID": { "type": "unique_id", "prefix": "CR" },
        "Date": { "type": "date" },
        "Requested By": {
          "type": "select",
          "options": [
            { "name": "Client", "color": "orange" },
            { "name": "Consultant", "color": "blue" }
          ]
        },
        "Change Description": { "type": "rich_text" },
        "Reason": { "type": "rich_text" },
        "Original Scope": { "type": "rich_text" },
        "Impact": { "type": "rich_text" },
        "Estimated Effort": { "type": "rich_text" },
        "Timeline Impact": { "type": "rich_text" },
        "Cost Impact": { "type": "rich_text" },
        "Approval Status": {
          "type": "select",
          "options": [
            { "name": "Pending", "color": "yellow" },
            { "name": "Approved", "color": "green" },
            { "name": "Rejected", "color": "red" }
          ]
        },
        "Approved By": { "type": "rich_text" },
        "Implementation Status": {
          "type": "select",
          "options": [
            { "name": "Not Started", "color": "gray" },
            { "name": "In Progress", "color": "blue" },
            { "name": "Implemented", "color": "green" },
            { "name": "Cancelled", "color": "red" }
          ]
        },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Pending Approval",
          "type": "table",
          "replaceDefault": true,
          "filter": { "property": "Approval Status", "select": { "equals": "Pending" } }
        },
        {
          "name": "Approved",
          "type": "table",
          "filter": { "property": "Approval Status", "select": { "equals": "Approved" } }
        },
        {
          "name": "Implemented",
          "type": "table",
          "filter": { "property": "Implementation Status", "select": { "equals": "Implemented" } }
        },
        {
          "name": "Rejected",
          "type": "table",
          "filter": { "property": "Approval Status", "select": { "equals": "Rejected" } }
        }
      ]
    },
    "risks": {
      "title": "Risks & Blockers",
      "icon": "⚠️",
      "parent": "databases",
      "titleProperty": "Risk/Blocker",
      "properties": {
        "Risk/Blocker": { "type": "title" },
        "Risk ID": { "type": "unique_id", "prefix": "RSK" },
        "Date Identified": { "type": "date" },
        "Type": {
          "type": "select",
          "options": [
            { "name": "Risk", "color": "yellow" },
            { "name": "Blocker", "color": "red" }
          ]
        },
        "Category": {
          "type": "select",
          "options": [
            { "name": "Technical", "color": "blue" },
            { "name": "Scope", "color": "purple" },
            { "name": "Client", "color": "orange" },
            { "name": "Third-party", "color": "brown" },
            { "name": "Schedule", "color": "yellow" },
            { "name": "Security", "color": "red" },
            { "name": "Other", "color": "gray" }
          ]
        },
        "Probability": {
          "type": "select",
          "options": [
            { "name": "Low", "color": "green" },
            { "name": "Medium", "color": "yellow" },
            { "name": "High", "color": "red" }
          ]
        },
        "Impact": {
          "type": "select",
          "options": [
            { "name": "Low", "color": "green" },
            { "name": "Medium", "color": "yellow" },
            { "name": "High", "color": "red" }
          ]
        },
        "Severity": {
          "type": "select",
          "options": [
            { "name": "Critical", "color": "red" },
            { "name": "High", "color": "orange" },
            { "name": "Medium", "color": "yellow" },
            { "name": "Low", "color": "gray" }
          ]
        },
        "Mitigation": { "type": "rich_text" },
        "Owner": {
          "type": "select",
          "options": [
            { "name": "Consultant", "color": "blue" },
            { "name": "Client", "color": "orange" }
          ]
        },
        "Status": {
          "type": "select",
          "options": [
            { "name": "Active", "color": "red" },
            { "name": "Monitoring", "color": "yellow" },
            { "name": "Resolved", "color": "green" }
          ]
        },
        "Target Resolution": { "type": "date" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Active Risks",
          "type": "table",
          "replaceDefault": true,
          "filter": {
            "and": [
              { "property": "Type", "select": { "equals": "Risk" } },
              { "property": "Status", "select": { "equals": "Active" } }
            ]
          }
        },
        {
          "name": "Critical Risks",
          "type": "table",
          "filter": {
            "and": [
              { "property": "Severity", "select": { "equals": "Critical" } },
              { "property": "Status", "select": { "does_not_equal": "Resolved" } }
            ]
          }
        },
        {
          "name": "Resolved",
          "type": "table",
          "filter": { "property": "Status", "select": { "equals": "Resolved" } }
        },
        {
          "name": "Blockers",
          "type": "table",
          "filter": {
            "and": [
              { "property": "Type", "select": { "equals": "Blocker" } },
              { "property": "Status", "select": { "does_not_equal": "Resolved" } }
            ]
          }
        }
      ]
    },
    "documents": {
      "title": "Project Documents",
      "icon": "📄",
      "parent": "databases",
      "titleProperty": "Document Name",
      "properties": {
        "Document Name": { "type": "title" },
        "Doc ID": { "type": "unique_id", "prefix": "DOC" },
        "Document Type": {
          "type": "select",
          "options": [
            { "name": "Agreement", "color": "gray" },
            { "name": "Requirement", "color": "blue" },
            { "name": "HLD", "color": "purple" },
            { "name": "LLD", "color": "purple" },
            { "name": "ER Diagram", "color": "green" },
            { "name": "API Documentation", "color": "orange" },
            { "name": "UI/UX", "color": "pink" },
            { "name": "AWS Architecture", "color": "yellow" },
            { "name": "Test Documentation", "color": "red" },
            { "name": "UAT", "color": "orange" },
            { "name": "Release", "color": "green" },
            { "name": "Handover", "color": "brown" }
          ]
        },
        "Version": { "type": "rich_text" },
        "Status": {
          "type": "select",
          "options": [
            { "name": "Draft", "color": "gray" },
            { "name": "Client Review", "color": "yellow" },
            { "name": "Pending Approval", "color": "orange" },
            { "name": "Approved", "color": "green" },
            { "name": "Superseded", "color": "red" }
          ]
        },
        "Owner": {
          "type": "select",
          "options": [
            { "name": "Consultant", "color": "blue" },
            { "name": "Client", "color": "orange" }
          ]
        },
        "Client Review Required": { "type": "checkbox" },
        "Client Approval Required": { "type": "checkbox" },
        "Date": { "type": "date" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "All Documents",
          "type": "table",
          "replaceDefault": true,
          "sorts": [{ "property": "Doc ID", "direction": "ascending" }]
        },
        {
          "name": "Client Review",
          "type": "table",
          "filter": { "property": "Status", "select": { "equals": "Client Review" } }
        },
        {
          "name": "Pending Approval",
          "type": "table",
          "filter": { "property": "Status", "select": { "equals": "Pending Approval" } }
        },
        {
          "name": "Approved Documents",
          "type": "table",
          "filter": { "property": "Status", "select": { "equals": "Approved" } }
        }
      ]
    },
    "projectControl": {
      "title": "Project Control",
      "icon": "🎛️",
      "parent": "databases",
      "titleProperty": "Project Name",
      "properties": {
        "Project Name": { "type": "title" },
        "Client": { "type": "rich_text" },
        "Overview": { "type": "rich_text" },
        "Consultant Role": { "type": "rich_text" },
        "Communication Cadence": { "type": "rich_text" },
        "Overall Status": {
          "type": "select",
          "options": [
            { "name": "On Track", "color": "green" },
            { "name": "At Risk", "color": "yellow" },
            { "name": "Off Track", "color": "red" }
          ]
        },
        "Overall Progress": { "type": "number", "format": "number" },
        "Client Notes": { "type": "rich_text" },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "Project Overview",
          "type": "table",
          "replaceDefault": true
        }
      ]
    },
    "internalNotes": {
      "title": "Internal Notes",
      "icon": "🔒",
      "parent": "internalNotesPage",
      "titleProperty": "Note Title",
      "properties": {
        "Note Title": { "type": "title" },
        "Date": { "type": "date" },
        "Category": {
          "type": "select",
          "options": [
            { "name": "Personal", "color": "gray" },
            { "name": "Estimate", "color": "yellow" },
            { "name": "Implementation", "color": "blue" },
            { "name": "Commercial", "color": "orange" }
          ]
        },
        "Internal Notes": { "type": "rich_text" }
      },
      "views": [
        {
          "name": "All Internal Notes",
          "type": "table",
          "replaceDefault": true,
          "sorts": [{ "property": "Date", "direction": "descending" }]
        }
      ]
    }
  },
  "relations": [
    {
      "from": "milestones",
      "name": "Dependencies",
      "to": "milestones",
      "type": "single_property"
    },
    {
      "from": "weekly",
      "name": "Milestone",
      "to": "milestones",
      "type": "dual_property",
      "syncedPropertyName": "Weekly Delivery"
    },
    {
      "from": "billing",
      "name": "Milestone",
      "to": "milestones",
      "type": "dual_property",
      "syncedPropertyName": "Billing"
    },
    {
      "from": "documents",
      "name": "Milestone",
      "to": "milestones",
      "type": "dual_property",
      "syncedPropertyName": "Documents"
    },
    {
      "from": "meetings",
      "name": "Milestone",
      "to": "milestones",
      "type": "dual_property",
      "syncedPropertyName": "Meetings"
    },
    {
      "from": "changeRequests",
      "name": "Milestone",
      "to": "milestones",
      "type": "dual_property",
      "syncedPropertyName": "Change Requests"
    },
    {
      "from": "projectControl",
      "name": "Current Phase",
      "to": "milestones",
      "type": "single_property"
    },
    {
      "from": "projectControl",
      "name": "Current Milestone",
      "to": "milestones",
      "type": "single_property"
    },
    {
      "from": "projectControl",
      "name": "Next Milestone",
      "to": "milestones",
      "type": "single_property"
    },
    {
      "from": "projectControl",
      "name": "Current Week",
      "to": "weekly",
      "type": "single_property"
    },
    {
      "from": "internalNotes",
      "name": "Related Milestone",
      "to": "milestones",
      "type": "single_property"
    }
  ],
  "milestones": [
    {
      "name": "Project Initiation",
      "phase": "Project Initiation",
      "description": "Confirm working arrangements, access, and how the project will be run.",
      "deliverables": "Agreed working cadence and project workspace for client review.",
      "status": "In Progress",
      "priority": "High",
      "progress": 0,
      "clientReview": true,
      "clientApproval": false
